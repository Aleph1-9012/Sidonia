{
  "colorSpace": "sRGB IEC61966-2.1",
  "transparency": "straight alpha",
  "colors": {
    "black": "#000000",
    "ink": "#191918",
    "white": "#FEFEFD",
    "whiteLow": "#F6F6F5",
    "gray200": "#D1D1D1",
    "gray350": "#AFAFAF",
    "gray500": "#909090",
    "gray650": "#6D6D6D",
    "gray750": "#505050",
    "red": "#D51F1D",
    "redDark": "#A4130F",
    "redSignal": "#EE1006",
    "yellow": "#FFC601"
  },
  "lineWeightsAt1x": {
    "hairline": 1,
    "thin": 2,
    "standard": 3,
    "strong": 4,
    "signal": 6
  },
  "spacingGrid": 4,
  "chamfers": [
    4,
    8,
    12,
    24,
    40
  ],
  "font": {
    "primary": "DejaVu Sans Mono",
    "fallback": "monospace",
    "note": "Live text is used in editable SVG sources; raster exports are self-contained."
  }
}